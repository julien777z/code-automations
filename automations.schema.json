{
  "$defs": {
    "AutomationConfig": {
      "additionalProperties": false,
      "description": "Define one automation.",
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergeConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AutomationConfig",
      "type": "object"
    },
    "MergeConfig": {
      "additionalProperties": false,
      "description": "Define automatic pull request merge behavior.",
      "properties": {
        "workflows": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Workflows",
          "type": "array"
        },
        "method": {
          "const": "squash",
          "default": "squash",
          "title": "Method",
          "type": "string"
        },
        "timeout_minutes": {
          "default": 120,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeout Minutes",
          "type": "integer"
        }
      },
      "required": [
        "workflows"
      ],
      "title": "MergeConfig",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "description": "Group repositories and automations for one project.",
      "properties": {
        "repositories": {
          "additionalProperties": {
            "$ref": "#/$defs/RepositoryConfig"
          },
          "minProperties": 1,
          "title": "Repositories",
          "type": "object"
        },
        "automations": {
          "additionalProperties": {
            "$ref": "#/$defs/AutomationConfig"
          },
          "minProperties": 1,
          "title": "Automations",
          "type": "object"
        }
      },
      "required": [
        "repositories",
        "automations"
      ],
      "title": "ProjectConfig",
      "type": "object"
    },
    "RepositoryConfig": {
      "additionalProperties": false,
      "description": "Configure one repository within a project.",
      "properties": {
        "branch": {
          "default": "main",
          "title": "Branch",
          "type": "string"
        }
      },
      "title": "RepositoryConfig",
      "type": "object"
    },
    "ScheduleConfig": {
      "additionalProperties": false,
      "description": "Define a timezone-aware POSIX cron schedule.",
      "properties": {
        "cron": {
          "title": "Cron",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "cron",
        "timezone"
      ],
      "title": "ScheduleConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Define the complete automation configuration.",
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "projects": {
      "additionalProperties": {
        "$ref": "#/$defs/ProjectConfig"
      },
      "minProperties": 1,
      "title": "Projects",
      "type": "object"
    }
  },
  "required": [
    "version",
    "projects"
  ],
  "title": "AutomationsConfig",
  "type": "object"
}
